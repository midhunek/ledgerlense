{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""},
    {"type": "panel", "id": "gauge", "name": "Gauge", "version": ""},
    {"type": "panel", "id": "stat", "name": "Stat", "version": ""}
  ],
  "annotations": {"list": []},
  "description": "LedgerLens — Invoice Extraction Observability",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 15},
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "histogram_quantile(0.99, sum(rate(ledgerlens_moderation_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "Moderation p99",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus"},
          "expr": "histogram_quantile(0.99, sum(rate(ledgerlens_extraction_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "Extraction p99",
          "refId": "B"
        }
      ],
      "title": "⏱ Latency p99 (seconds)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"fixedColor": "#6366f1", "mode": "fixed"},
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "id": 2,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area"},
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "ledgerlens_token_cost_usd_total",
          "legendFormat": "Total Token Cost",
          "refId": "A"
        }
      ],
      "title": "💰 Cumulative Token Cost (USD)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"fixedColor": "#4ade80", "mode": "fixed"},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "id": 3,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area"},
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "ledgerlens_auto_approvals_total / clamp_min(ledgerlens_auto_approvals_total + ledgerlens_pending_review_total, 1) * 100",
          "legendFormat": "Auto-Approval %",
          "refId": "A"
        }
      ],
      "title": "✅ Auto-Approval Rate (%)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"fixedColor": "#06b6d4", "mode": "fixed"},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 4},
      "id": 4,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area"},
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "ledgerlens_throughput_docs_per_minute",
          "legendFormat": "Docs/min",
          "refId": "A"
        }
      ],
      "title": "🚀 Throughput (docs/min)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"fixedColor": "#fbbf24", "mode": "fixed"},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 4},
      "id": 5,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area"},
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "ledgerlens_pending_review_total",
          "legendFormat": "Pending Review",
          "refId": "A"
        }
      ],
      "title": "⚠️ Pending Review (total)",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["ledgerlens", "invoices", "ai"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "LedgerLens — Invoice Observability",
  "uid": "ledgerlens-main",
  "version": 1
}
