# LedgerLens — Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit the .env file — it is in .gitignore

# -----------------------------------------------------------------------
# Option A: OpenAI
# -----------------------------------------------------------------------
# OPENAI_API_KEY=sk-...your-openai-key-here...
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=

# -----------------------------------------------------------------------
# Option B: Groq (free tier, fast inference)
# Get your key at: https://console.groq.com/keys
# -----------------------------------------------------------------------
# OPENAI_API_KEY=gsk_...your-groq-key-here...
# OPENAI_MODEL=qwen/qwen3.6-27b
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Active configuration (uncomment one block above, or fill in below)
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=

# Moderation (OpenAI only — auto-bypassed when using Groq)
MODERATION_MODEL=omni-moderation-latest

# Confidence routing threshold (0.0 - 1.0)
REVIEW_THRESHOLD=0.75

# Cost tracking (USD per token)
MODEL_COST_PER_TOKEN=0.000005

# Database
DATABASE_URL=sqlite:///./ledgerlens.db

# Storage directories (relative to backend/)
UPLOADS_DIR=uploads
PROCESSED_DIR=processed

# App
APP_NAME=LedgerLens
DEBUG=false
